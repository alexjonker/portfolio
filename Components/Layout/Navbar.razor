@inject PortfolioDataService Portfolio

<nav class="border-b border-neutral-200 bg-neutral-50 text-neutral-900">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a class="flex items-center gap-4" href="/">
            <img class="h-8 w-8 rounded-lg" src="/images/profile.png" alt="Profile picture" />
            <span class="text-sm font-semibold uppercase tracking-[0.2em]">@Portfolio.Site.DisplayName</span>
        </a>

        <div class="flex flex-wrap items-center gap-4 text-sm text-neutral-600">
            <a class="transition-colors hover:text-neutral-900" href="/">Home</a>
            <a class="transition-colors hover:text-neutral-900" href="/projects">Projects</a>
            <a class="transition-colors hover:text-neutral-900" href="/education">Education</a>
            <a class="transition-colors hover:text-neutral-900" href="/skills">Skills</a>
            @foreach (var link in Portfolio.Site.Social)
            {
                var label = GetSocialLabel(link);
                <a class="transition-colors hover:text-neutral-900" href="@link.Url" aria-label="@label" title="@label">
                    <img src="@link.IconPath" alt="@label" class="h-4 w-4" />
                </a>
            }
        </div>
    </div>
</nav>

@code
{
    private static string GetSocialLabel(SocialLink link)
    {
        var label = GetLabelFromIconPath(link.IconPath);
        if (string.IsNullOrWhiteSpace(label))
        {
            if (Uri.TryCreate(link.Url, UriKind.Absolute, out var uri) && !string.IsNullOrWhiteSpace(uri.Host))
            {
                label = uri.Host;
            }
        }

        if (string.IsNullOrWhiteSpace(label))
        {
            return "Social";
        }

        return char.ToUpperInvariant(label[0]) + label[1..];
    }

    private static string GetLabelFromIconPath(string iconPath)
    {
        if (string.IsNullOrWhiteSpace(iconPath))
        {
            return string.Empty;
        }

        var fileName = System.IO.Path.GetFileNameWithoutExtension(iconPath);
        return string.IsNullOrWhiteSpace(fileName) ? string.Empty : fileName.Replace('-', ' ');
    }
}