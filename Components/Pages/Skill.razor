@page "/skills/{Slug}"
@inject NavigationManager Navigation
@inject PortfolioDataService Portfolio

<PageTitle>@_skill.Name</PageTitle>


<section class="min-h-screen bg-neutral-50 text-neutral-900">
    <div class="mx-auto max-w-3xl px-6 py-16">
        <header class="border-b border-neutral-200 pb-6">
            <p class="text-sm uppercase tracking-[0.2em] text-neutral-500">Skill</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight">@_skill.Name</h1>
        </header>
        
        <div class="mt-6 grid gap-4 text-sm text-neutral-700">
            <p class="whitespace-pre-line">@_skill.Description</p>
        </div>
    </div>
</section>


@code {
    [Parameter] public string? Slug { get; set; }

    private SkillItem? _skill;

    protected override void OnParametersSet()
    {
        _skill = Portfolio.GetSkill(Slug);

        if (_skill is null)
        {
            Navigation.NavigateTo("/404", true);
        }
    }
}
