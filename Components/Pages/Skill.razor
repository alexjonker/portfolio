@page "/skills/{Slug}"
@inject NavigationManager Navigation
@inject PortfolioDataService Portfolio

<PageTitle>@_skill?.Name</PageTitle>


<section class="min-h-screen bg-neutral-50 text-neutral-900">
    <div class="mx-auto max-w-3xl px-6 py-16">
        <header class="border-b border-neutral-200 pb-6">
            <p class="text-sm uppercase tracking-[0.2em] text-neutral-500">Skill</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight">@_skill?.Name</h1>
        </header>
        
        <div class="mt-6 grid gap-4 text-sm text-neutral-700">
            <ContentRenderer Html="@_skill?.Html" RootClass="grid gap-3 [&>p]:mt-0" />
        </div>

        @if (_relatedProjects.Count > 0)
        {
            <div class="mt-6 grid gap-3">
                <p class="text-xs uppercase tracking-[0.2em] text-neutral-500">Projects this was used in</p>
                <div class="flex flex-wrap gap-3">
                    @foreach (var project in _relatedProjects)
                    {
                        <a class="border border-neutral-200 bg-white px-4 py-2 text-sm transition-colors hover:border-neutral-400" href="@($"/projects/{project.Slug}")" rel="noreferrer">@project.Name</a>
                    }
                </div>
            </div>
        }

        @if (_relatedEducation.Count > 0)
        {
            <div class="mt-6 grid gap-3">
                <p class="text-xs uppercase tracking-[0.2em] text-neutral-500">Education where I used/learned this</p>
                <div class="flex flex-wrap gap-3">
                    @foreach (var item in _relatedEducation)
                    {
                        <a class="border border-neutral-200 bg-white px-4 py-2 text-sm transition-colors hover:border-neutral-400" href="@($"/education/{item.Slug}")" rel="noreferrer">@item.Name</a>
                    }
                </div>
            </div>
        }
    </div>
</section>



@code {
    [Parameter] public string? Slug { get; set; }

    private SkillItem? _skill;
    private IReadOnlyList<ProjectItem> _relatedProjects = Array.Empty<ProjectItem>();
    private IReadOnlyList<EducationItem> _relatedEducation = Array.Empty<EducationItem>();

    protected override void OnParametersSet()
    {
        _skill = Portfolio.GetSkill(Slug);

        if (_skill is null)
        {
            Navigation.NavigateTo("/404", true);
            return;
        }

        _relatedProjects = Portfolio.Projects
            .Where(project => project.Skills.Any(skill =>
                skill.Equals(_skill?.Slug, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        _relatedEducation = Portfolio.Education
            .Where(item => item.Skills.Any(skill =>
                skill.Equals(_skill?.Slug, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }
}
