@page "/education/{Slug}"
@using System.IO
@using System.Text.RegularExpressions
@inject NavigationManager Navigation
@inject PortfolioDataService Portfolio

<PageTitle>@_education.name</PageTitle>

<section class="min-h-screen bg-neutral-50 text-neutral-900">
    <div class="mx-auto max-w-3xl px-6 py-16">
        <header class="border-b border-neutral-200 pb-6">
            <p class="text-sm uppercase tracking-[0.2em] text-neutral-500">Education</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight">@_education.name</h1>
        </header>

        <div class="mt-6 grid gap-4 text-sm text-neutral-700">
            <div class="flex items-center gap-2">
                <span class="text-xs uppercase tracking-[0.2em] text-neutral-500">Period</span>
                <span>@_education.Period</span>
            </div>

            <div class="flex items-center gap-2">
                <span class="text-xs uppercase tracking-[0.2em] text-neutral-500">Location</span>
                <span>@_education.Location</span>
            </div>

            <p>@_education.Summary</p>

            <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs uppercase tracking-[0.2em] text-neutral-500">Skills</span>
                @foreach (var skill in _linkedSkills)
                {
                    <a class="border border-neutral-200 bg-white px-3 py-1 text-xs text-neutral-600" href="@($"/skills/{skill.Slug}")">@skill.Name</a>
                }
            </div>


            @foreach (var block in _descriptionBlocks)
            {
                if (block.IsImage)
                {
                    <img class="education-image w-full rounded-lg border border-neutral-200 bg-white" src="@block.Value" alt="@block.Alt" loading="lazy" />
                }
                else
                {
                    <p class="whitespace-pre-line">@block.Value</p>
                }
            }
            
            @if (_education.Links.Count > 0)
            {
                <div class="flex flex-wrap gap-3">
                    @foreach (var link in _education.Links)
                    {
                        <a class="border border-neutral-200 bg-white px-4 py-2 text-sm transition-colors hover:border-neutral-400" href="@link.Url" target="_blank" rel="noreferrer">@link.Label</a>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public string? Slug { get; set; }

    private EducationItem? _education;
    private IReadOnlyList<SkillItem> _linkedSkills = Array.Empty<SkillItem>();
    private IReadOnlyList<DescriptionBlock> _descriptionBlocks = Array.Empty<DescriptionBlock>();

    private static readonly Regex ImageTagRegex = new(@"\[(?<path>images\/[^\]\s]+)\]", RegexOptions.IgnoreCase | RegexOptions.Compiled);

    protected override void OnParametersSet()
    {
        _education = Portfolio.GetEducation(Slug);

        if (_education is null)
        {
            Navigation.NavigateTo("/404", true);
            return;
        }

        _linkedSkills = Portfolio.ResolveSkills(_education.skills);
        _descriptionBlocks = ParseDescription(_education.Description);
    }

    private static IReadOnlyList<DescriptionBlock> ParseDescription(string? description)
    {
        if (string.IsNullOrWhiteSpace(description)) return Array.Empty<DescriptionBlock>();

        var blocks = new List<DescriptionBlock>();
        var lastIndex = 0;

        foreach (Match match in ImageTagRegex.Matches(description))
        {
            if (match.Index > lastIndex)
            {
                var text = description.Substring(lastIndex, match.Index - lastIndex);
                if (!string.IsNullOrWhiteSpace(text))
                {
                    blocks.Add(DescriptionBlock.Text(text.Trim('\r', '\n')));
                }
            }

            var path = match.Groups["path"].Value;
            if (!path.StartsWith('/'))
            {
                path = "/" + path;
            }

            var altText = BuildAltText(path);
            blocks.Add(DescriptionBlock.Image(path, altText));
            lastIndex = match.Index + match.Length;
        }

        if (lastIndex < description.Length)
        {
            var remaining = description[lastIndex..];
            if (!string.IsNullOrWhiteSpace(remaining))
            {
                blocks.Add(DescriptionBlock.Text(remaining.Trim('\r', '\n')));
            }
        }

        return blocks;
    }

    private static string BuildAltText(string path)
    {
        var fileName = Path.GetFileNameWithoutExtension(path);
        return string.IsNullOrWhiteSpace(fileName)
            ? "Education image"
            : fileName.Replace('-', ' ').Replace('_', ' ');
    }

    private sealed record DescriptionBlock(bool IsImage, string Value, string? Alt)
    {
        public static DescriptionBlock Text(string value) => new(false, value, null);
        public static DescriptionBlock Image(string value, string alt) => new(true, value, alt);
    }
}
