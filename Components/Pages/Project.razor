@page "/projects/{Slug}"
@inject NavigationManager Navigation
@inject PortfolioDataService Portfolio

<PageTitle>@_project.Name</PageTitle>


<section class="min-h-screen bg-neutral-50 text-neutral-900">
    <div class="mx-auto max-w-3xl px-6 py-16">
        <header class="border-b border-neutral-200 pb-6">
            <p class="text-sm uppercase tracking-[0.2em] text-neutral-500">Project</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight">@_project.Name</h1>
            <p class="mt-3 text-base text-neutral-600">@_project.Summary</p>
        </header>
        <div class="mt-6 grid gap-4 text-sm text-neutral-700">
            <div class="flex items-center gap-2">
                <span class="text-xs uppercase tracking-[0.2em] text-neutral-500">Period</span>
                <span>@_project.Period</span>
            </div>
            

            @if (_linkedSkills.Count > 0)
            {
                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs uppercase tracking-[0.2em] text-neutral-500">Skills</span>
                    @foreach (var skill in _linkedSkills)
                    {
                        <a class="border border-neutral-200 bg-white px-3 py-1 text-xs text-neutral-600" href="@($"/skills/{skill.Slug}")">@skill.Name</a>
                    }
                </div>
            }

            <p class="whitespace-pre-line text-sm text-neutral-700">@_project.Description</p>
            
            @if (_project.Links.Count > 0)
            {
                <div class="flex flex-wrap gap-3">
                    @foreach (var link in _project.Links)
                    {
                        <a class="border border-neutral-200 bg-white px-4 py-2 text-sm transition-colors hover:border-neutral-400" href="@link.Url" target="_blank" rel="noreferrer">@link.Label</a>
                    }
                </div>
            }
        </div>
    </div>
</section>


@code {
    [Parameter] public string? Slug { get; set; }

    private ProjectItem? _project;
    private IReadOnlyList<SkillItem> _linkedSkills = Array.Empty<SkillItem>();

    protected override void OnParametersSet()
    {
        _project = Portfolio.GetProject(Slug);

        if (_project is null)
        {
            Navigation.NavigateTo("/404", true);
            return;
        }

        _linkedSkills = Portfolio.ResolveSkills(_project.skills);
    }
}
