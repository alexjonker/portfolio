@page "/education"
@inject PortfolioDataService Portfolio

<PageTitle>@Portfolio.Site.DisplayName | Education</PageTitle>

<section class="min-h-screen bg-neutral-50 text-neutral-900">
    <div class="mx-auto max-w-3xl px-6 py-16">
        <header class="border-b border-neutral-200 pb-6">
            <h1 class="mt-3 text-3xl font-semibold tracking-tight">Education</h1>
            <p class="mt-3 text-base text-neutral-600">All schools and internships I've gone to.</p>
        </header>

        <div class="mt-8 grid gap-4">
            @foreach (var item in Portfolio.Education)
            {
                <a href="@($"/education/{item.Slug}")">
                    <article class="border border-neutral-200 bg-white p-4">
                        <div class="flex items-center justify-between">
                            <h2 class="text-base font-semibold">@item.name</h2>
                            <span class="text-xs text-neutral-500">@item.Period</span>
                        </div>
                        <p class="mt-2 text-sm text-neutral-600">@item.Location</p>
                    </article>
                </a>
            }
        </div>
    </div>
</section>
