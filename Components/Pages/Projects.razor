@page "/projects"
@inject PortfolioDataService Portfolio

<PageTitle>Projects</PageTitle>

<section class="min-h-screen bg-neutral-50 text-neutral-900">
    <div class="mx-auto max-w-3xl px-6 py-16">
        <header class="border-b border-neutral-200 pb-6">
            <h1 class="mt-3 text-3xl font-semibold tracking-tight">Projects</h1>
            <p class="mt-3 text-base text-neutral-600">All projects I've worked on that are worth sharing.</p>
        </header>

        <div class="mt-8 grid gap-4">
            @foreach (var project in Portfolio.Projects)
            {
                <a href="@($"/projects/{project.Slug}")">
                    <article class="border border-neutral-200 bg-white p-4">
                        <div class="flex items-center justify-between">
                            <h2 class="text-base font-semibold">@project.Name</h2>
                            <span class="text-xs text-neutral-500">@project.Period</span>
                        </div>
                        <p class="mt-2 text-sm text-neutral-600">@project.Summary</p>
                    </article>
                </a>
            }
        </div>
    </div>
</section>
