@page "/"

<PageTitle>Alex Jonker - home</PageTitle>

<section class="hero">
    <h1>
        Alex Jonker<span>.</span>
    </h1>

    <div class="description">
        <p>
            I'm a student Software Developer from the Netherlands.
        </p>
        <p>
            I enjoy coding and homelabbing.
        </p>
    </div>

    <div class="actions">
        <a href="/projects" class="button primary">
            View projects
        </a>

        <a href="#contact" class="button secondary">
            Contact me
        </a>
    </div>
</section>

@* TECH STACK *@
<section id="stack">
    <span class="stack-label">
        STACK
    </span>

    <span class="tag">C# / .NET</span>
    <span class="tag">Blazor</span>
    <span class="tag">Linux</span>
    <span class="tag">Docker</span>
    <span class="tag">Proxmox</span>
    <span class="tag">Git</span>
</section>

@* PROJECTS *@
<section id="projects">
    <div class="section-header">
        <h2>Featured Projects</h2>
        <a class="button secondary" href="/projects">View all</a>
    </div>

    <div class="projects">
        @foreach (var project in ProjectData.AllProjectsList)
        {
            @if (project.Featured)
            {
                <a href="/projects/@project.Name" class="project">
                    <h3>@project.Name</h3>
                    <p>@project.Description</p>
                    <div class="project-tags">
                        @foreach (var tag in project.Tags)
                        {
                            <span class="tag">@tag</span>
                        }
                    </div>
                </a>
            }
        }
    </div>
</section>

@* ABOUT ME *@
<section id="about">
    <h2>About Me</h2>

    <div class="about-grid">
        <div class="about-text">
            <p>
                I'm a Software Development student who enjoys working on the backend of applications.
                I like working with Linux, Docker, and self-hosted services.
            </p>
            <p>
                I care a lot about privacy, so I run my own homelab to replace as many big-corp
                services as I can. It's a mini PC running Proxmox, with an Alpine Linux VM hosting
                all my Docker containers: Nextcloud, Immich, Vaultwarden, AdGuard Home and much more.
            </p>
            <p>
                My phone is a Pixel 8 running GrapheneOS and my laptop is a Framework 13 running Artix Linux.
            </p>
            <p>
                This portfolio is running on my homelab too =) It's exposed through a Hetzner VPS in
                Germany running Pangolin, so my home IP is never made public and doesn't need to be static.
            </p>
            <p>
                As you may have seen in this site, I love Gruvbox.
            </p>
            <p>
                I'm also a car enthusiast, and I love driving my Miata.
            </p>
        </div>
        <div class="term">
            <div class="term-bar">
                <p>foot</p>
            </div>
            <div class="term-body">
                <p>[<span>alex</span>@@portfolio<span>&nbsp;~</span>]$ fetch</p>
                <div class="term-output">
                    <p><span>Host</span> Framework 13</p>
                    <p><span>OS</span> Artix Linux</p>
                    <p><span>WM</span> mango</p>
                    <p><span>Shell</span> fish</p>
                    <p><span>Terminal</span> foot</p>
                    <p><span>Theme</span> Gruvbox</p>
                    <p><span>Editor</span> VSCodium</p>
                </div>
                <p class="typing">[<span>alex</span>@@portfolio<span>&nbsp;~</span>]$ </p>
            </div>
        </div>
    </div>
</section>


@* CONTACT *@
<section id="contact">
    <h2>Contact</h2>
    <div class="contact-content">
        <p>Want to get into contact?</p>
        <p>Message me on Matrix or LinkedIn.</p>
        <div class="actions">
            <a href="https://matrix.to/#/@@alex:matrix.alexjonker.dev"class="button primary">Matrix</a>
            <a href="https://linkedin.com/in/ar-jonker" class="button primary">LinkedIn</a>
            <a href="https://github.com/alexjonker" class="button secondary">GitHub</a>
        </div>
    </div>
</section>

