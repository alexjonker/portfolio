@page "/"
@using System.Linq
@inject PortfolioDataService Portfolio

<PageTitle>Home</PageTitle>

<section class="min-h-screen bg-neutral-50 text-neutral-900">
	<div class="mx-auto max-w-4xl px-6 py-16">
		<div class="flex flex-col gap-10">
			<header class="border-b border-neutral-200 pb-8">
				<h1 class="mt-3 text-4xl font-semibold tracking-tight">@Portfolio.Home.Hero.Title</h1>
				<ContentRenderer Html="@Portfolio.Home.Hero.SummaryHtml" RootClass="mt-3 max-w-2xl text-base text-neutral-600 [&>p]:mt-2 [&>p:first-child]:mt-0" />
				<div class="mt-6 flex flex-wrap gap-3">
					<a class="border border-neutral-200 bg-white px-4 py-2 text-sm font-semibold" href="/projects">View projects</a>
					<a class="border border-neutral-200 bg-neutral-900 px-4 py-2 text-sm font-semibold text-neutral-50" href="/skills">View skills</a>
				</div>
			</header>

			<section class="grid gap-4">
				<div class="flex items-end justify-between">
					<h2 class="text-lg font-semibold">Featured projects</h2>
					<a class="text-sm text-neutral-600" href="/projects">See all</a>
				</div>
				<div class="grid gap-4">
					@foreach (var project in Portfolio.GetHomeProjects(3))
					{
						<a href="@($"/projects/{project.Slug}")">
							<article class="border border-neutral-200 bg-white p-4">
								<div class="flex items-center justify-between">
									<h3 class="text-base font-semibold">@project.Name</h3>
									<span class="text-xs text-neutral-500">@project.Period</span>
								</div>
								<p class="mt-2 text-sm text-neutral-600">@project.Summary</p>
							</article>
						</a>
					}
				</div>
			</section>

			<section class="grid gap-4">
				<div class="flex items-end justify-between">
					<h2 class="text-lg font-semibold">Education</h2>
					<a class="text-sm text-neutral-600" href="/education">See all</a>
				</div>
				<div class="grid gap-4">
					@foreach (var item in Portfolio.GetHomeEducation(1))
					{
						<a href="@($"/education/{item.Slug}")">
							<article class="border border-neutral-200 bg-white p-4">
								<div class="flex flex-wrap items-center justify-between gap-2">
									<h3 class="text-base font-semibold">@item.Name</h3>
									<span class="text-xs text-neutral-500">@item.Period</span>
								</div>
								<p class="mt-1 text-xs text-neutral-500">@item.Location</p>
								<p class="mt-2 text-sm text-neutral-600">@item.Summary</p>
							</article>
						</a>
					}
				</div>
			</section>

			<section class="grid gap-4">
				<div class="flex items-end justify-between">
					<h2 class="text-lg font-semibold">Key skills</h2>
					<a class="text-sm text-neutral-600" href="/skills">See all</a>
				</div>
				<div class="flex flex-wrap gap-2">
					@foreach (var skill in Portfolio.GetHomeSkills(10))
					{
						<a class="border border-neutral-200 bg-white px-3 py-1 text-sm" href="@($"/skills/{skill.Slug}")">@skill.Name</a>
					}
				</div>
			</section>
		</div>
	</div>
</section>

