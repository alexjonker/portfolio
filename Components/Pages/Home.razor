@page "/"

<PageTitle>Alex Jonker - home</PageTitle>

<section class="hero">
    <h1>
        Alex Jonker<span>.</span>
    </h1>

    <div class="description">
        <p>
            I'm a student Software Developer from the Netherlands.
        </p>
        <p>
            I enjoy coding and homelabbing.
        </p>
    </div>

    <div class="actions">
        <a href="#projects" class="button primary">
            View projects
        </a>

        <a href="#contact" class="button secondary">
            Contact me
        </a>
    </div>
</section>

@* TECH STACK *@
<section id="stack">
    <span class="stack-label">
        STACK
    </span>

    <span class="tag">C# / .NET</span>
    <span class="tag">Blazor</span>
    <span class="tag">Linux</span>
    <span class="tag">Docker</span>
    <span class="tag">Proxmox</span>
    <span class="tag">Git</span>
</section>

@* PROJECTS *@

@code {

    record Project(string Name, string Description, string[] Tags);

    static readonly Project[] Projects =
    [
        new("nowa-dash",
            "A Raspberry Pi dashboard made using Arch Linux ARM, Labwc and Quickshell.",
            ["Linux", "Raspberry Pi"]),

        new("tidawnloader",
            "A self-hosted app to download music from tidal. Made with C# and Blazor",
            ["Linux", "C#", "Blazor", "Docker"]),

        new("xrooster",
            "A Flutter app for viewing your school schedule from MyX.",
            ["Flutter", "Dart", "Android"]),

        new("homelab",
            "A Proxmox-based homelab running Docker, self-hosted services and infrastructure for projects and everyday use.",
            ["Proxmox", "Docker", "Linux"]),

        new("portfolio",
            "A portfolio made with C# and Blazor, running on Linux using Docker.",
            ["Linux", "C#", "Blazor", "Docker"]),
    ];

}

<section id="projects">
    <div class="section-header">
        <h2>Projects</h2>
        <a class="button secondary" href="/projects">View all</a>
    </div>

    <div class="projects">
        @foreach (var project in Projects)
        {
            <a href="/projects/@project.Name" class="project">
                <h3>@project.Name</h3>
                <p>@project.Description</p>
                <div class="project-tags">
                    @foreach (var tag in project.Tags)
                    {
                        <span class="tag">@tag</span>
                    }
                </div>
            </a>
        }
    </div>
</section>

@* ABOUT ME *@
<section id="about">
    <h2>About Me</h2>

    <div class="about-grid">
        <div class="about-text">
            <p>
                I'm a Software Development student who enjoys working on the backend of applications.
            </p>
            <p>
                I like working with Linux, Docker, and self-hosted services.
            </p>
            <p>
                In my free time, I run my own homelab, mess around with Linux and work on my personal projects.
            </p>
        </div>

        <div class="term">
            <div class="term-bar">
                <p>foot</p>
            </div>
            <div class="term-body">
                <p>[<span>alex</span>@@portfolio<span>&nbsp;~</span>]$ fetch</p>
                <div class="term-output">
                    <p><span>OS</span> Artix Linux</p>
                    <p><span>WM</span> mango</p>
                    <p><span>Shell</span> fish</p>
                    <p><span>Terminal</span> foot</p>
                    <p><span>Theme</span> Gruvbox</p>
                    <p><span>Editor</span> VSCodium</p>
                </div>
                <p class="typing">[<span>alex</span>@@portfolio<span>&nbsp;~</span>]$ </p>
            </div>
        </div>
    </div>
</section>


@* CONTACT *@
<section id="contact">
    <h2>Contact</h2>
</section>

